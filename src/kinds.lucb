## The node kinds an instrument's patch is built from: each one's name,
## category, ports and parameters. The engine runs them (`dsp`, `program`);
## an application reads this table to offer and draw them, so a kind added
## here appears in its menus without more work.
##
## Every signal is a block of f32 samples. Pitch is in octaves from middle C
## (note 60 is 0.0, an octave up 1.0), so a pitch and a modulation add.
## Gates and envelopes run 0..1, bipolar modulation -1..1.

pub struct ParamSpec:
    pub let name: str
    pub let minimum: f64
    pub let maximum: f64
    pub let initial: f64
    ## What the value is shown in: "Hz", "s", "ms", "dB", "%", "st", "" (none).
    pub let units: str
    ## A menu's items, "Sine|Triangle|Saw|Square"; empty for a number.
    pub let items: str = ""
    ## The slider moves on a logarithmic scale (frequencies, times).
    pub let logarithmic: bool = false

pub struct KindSpec:
    pub let name: str
    pub let category: str
    ## Input and output port names, comma-separated.
    pub let inputs: str
    pub let outputs: str
    ## This kind's parameters: `params[first..<first + count]`.
    pub let first: u32
    pub let count: u32
    pub let doc: str

