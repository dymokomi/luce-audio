pub let kinds: KindSpec[54] = [
    KindSpec(name = "Note In", category = "Inputs", inputs = "", outputs = "pitch,gate,velocity,pan", first = 0, count = 0,
             doc = "The voice's note: pitch in octaves from middle C, gate while held, velocity and the clip's pan."),
    KindSpec(name = "Control In", category = "Inputs", inputs = "", outputs = "value", first = 0, count = 1,
             doc = "One of the instrument's eight control inputs: a curve lane wired to it on the track."),
    KindSpec(name = "Audio In", category = "Inputs", inputs = "", outputs = "left,right", first = 0, count = 0,
             doc = "The audio wired into this instrument on the track: an effect's input."),
    KindSpec(name = "Output", category = "Inputs", inputs = "left,right", outputs = "", first = 1, count = 1,
             doc = "What the instrument plays; a lone left input plays in both channels."),
    KindSpec(name = "Oscillator", category = "Sources", inputs = "pitch,phase,width", outputs = "out", first = 2, count = 6,
             doc = "A band-limited sine, triangle, saw or pulse at the pitch input; phase modulation makes FM tones."),
    KindSpec(name = "Noise", category = "Sources", inputs = "", outputs = "out", first = 8, count = 1,
             doc = "White noise."),
    KindSpec(name = "Filter", category = "Filters", inputs = "in,cutoff,resonance", outputs = "out", first = 9, count = 3,
             doc = "A state-variable filter; the cutoff input moves the cutoff in octaves."),
    KindSpec(name = "Envelope", category = "Modulation", inputs = "gate", outputs = "out", first = 12, count = 4,
             doc = "Attack, decay, sustain and release, from 0 to 1 and back, started by the gate."),
    KindSpec(name = "LFO", category = "Modulation", inputs = "rate", outputs = "out", first = 16, count = 3,
             doc = "A slow oscillator from -1 to 1; the rate input moves its rate in octaves."),
    KindSpec(name = "Mix", category = "Utilities", inputs = "a,b,c,d", outputs = "out", first = 19, count = 4,
             doc = "The sum of four inputs, each with its gain."),
    KindSpec(name = "Multiply", category = "Utilities", inputs = "a,b", outputs = "out", first = 0, count = 0,
             doc = "A times B: an amplifier when B is an envelope."),
    KindSpec(name = "Gain", category = "Utilities", inputs = "in,amount", outputs = "out", first = 23, count = 1,
             doc = "The input louder or softer; a wired amount multiplies it again."),
    KindSpec(name = "Pan", category = "Utilities", inputs = "in,pan", outputs = "left,right", first = 24, count = 1,
             doc = "One channel to two at equal power; the pan input adds to the setting."),
    KindSpec(name = "Soft Clip", category = "Effects", inputs = "in", outputs = "out", first = 25, count = 2,
             doc = "Soft saturation."),
    KindSpec(name = "Simple Delay", category = "Effects", inputs = "in", outputs = "out", first = 27, count = 3,
             doc = "An echo up to two seconds long."),
    KindSpec(name = "Constant", category = "Utilities", inputs = "", outputs = "out", first = 30, count = 1,
             doc = "A fixed value."),
    KindSpec(name = "Glide", category = "Modulation", inputs = "in", outputs = "out", first = 31, count = 1,
             doc = "Follows its input slowly: portamento on a pitch."),
    KindSpec(name = "Room", category = "Effects", inputs = "left,right", outputs = "left,right", first = 32, count = 3,
             doc = "A stereo room."),
    KindSpec(name = "Ladder", category = "Filters", inputs = "in,cutoff,resonance", outputs = "out", first = 35, count = 6,
             doc = "A Moog-style 4-pole transistor ladder: resonance sings to self-oscillation and thins the bass (Bass puts it back); Drive pushes it into its saturation."),
    KindSpec(name = "SEM", category = "Filters", inputs = "in,cutoff,resonance,mode", outputs = "out", first = 41, count = 6,
             doc = "The Oberheim SEM / OB-6 2-pole state-variable filter: Mode sweeps low pass through notch to high pass (Band: through band pass); creamy resonance that compresses rather than screams."),
    KindSpec(name = "CS Filter", category = "Filters", inputs = "in,cutoff,low", outputs = "out", first = 47, count = 6,
             doc = "The Yamaha CS-80's filter: a resonant 12 dB high pass into a resonant 12 dB low pass; the cutoff input moves both, the low input only the low pass."),
    KindSpec(name = "MS-20", category = "Filters", inputs = "in,cutoff,low", outputs = "out", first = 53, count = 7,
             doc = "The Korg MS-20 pair: a resonant high pass into the Korg35 low pass with a diode clipper in its loop; turn the low Peak up for the scream. Flavor: Korg35 (all distorts) or OTA (only the peak)."),
    KindSpec(name = "Analog VCO", category = "Sources", inputs = "pitch,fm,phase,width,sync", outputs = "out", first = 60, count = 9,
             doc = "An analog oscillator: Shape morphs triangle, saw and pulse (Pulse Width also skews the triangle, the Minimoog's shark tooth); a sub an octave down; Drift lets it wander as real VCOs do; sync restarts it."),
    KindSpec(name = "Analog Envelope", category = "Modulation", inputs = "gate,velocity", outputs = "out", first = 69, count = 8,
             doc = "An analog ADSR: the attack charges toward past its peak (snappy, as a CEM3310's), decay and release fall exponentially; a retrigger starts from where it is. Initial and Peak are the CS-80's levels."),
    KindSpec(name = "OTA VCA", category = "Utilities", inputs = "in,cv", outputs = "out", first = 77, count = 5,
             doc = "An analog VCA: the cv opens it linearly (an OTA) or exponentially (a Blackmer cell); Drive saturates it as an OTA does, Asymmetry adds even harmonics; closed, it bleeds a whisper."),
    KindSpec(name = "Multimode", category = "Filters", inputs = "in,cutoff,resonance", outputs = "out", first = 82, count = 4,
             doc = "The Elektron 2-pole multimode (Rytm, A4 filter 2, Analog Heat): LP2, LP1, BP, HP1, HP2, BS and PK from one state-variable filter."),
    KindSpec(name = "Drive", category = "Effects", inputs = "in,drive", outputs = "out", first = 86, count = 7,
             doc = "Analog drive after the OTO BOUM and Elektron Analog Heat: a low cut into one of eight circuits, then a 12 dB high cut and a mix. Bias (SYM) makes it asymmetric."),
    KindSpec(name = "Kick", category = "Drums", inputs = "gate,velocity,pitch", outputs = "out", first = 93, count = 10,
             doc = "An analog kick: 808, a pinged resonator whose pitch jumps then sighs; 909, a shaped triangle swept down with a click. Velocity is the accent."),
    KindSpec(name = "Snare", category = "Drums", inputs = "gate,velocity,pitch", outputs = "out", first = 103, count = 9,
             doc = "An analog snare (808: two modes, 909: five) with snappy noise, or a tom (one mode)."),
    KindSpec(name = "Metal", category = "Drums", inputs = "gate,velocity", outputs = "out", first = 112, count = 6,
             doc = "Hats, cymbals and cowbell after the 808: six detuned squares through a band pass and a swing VCA."),
    KindSpec(name = "Clap", category = "Drums", inputs = "gate,velocity", outputs = "out", first = 118, count = 8,
             doc = "The 808 clap: band-passed noise in a train of fast bursts, then a tail."),
    KindSpec(name = "Tine Piano", category = "Sources", inputs = "pitch,gate,velocity", outputs = "out", first = 126, count = 10,
             doc = "A Rhodes: struck tine modes read by the electromagnetic pickup's curve, so playing harder barks; Symmetry is the tine's place before the pickup (0 on axis: bell-like, off axis: more fundamental)."),
    KindSpec(name = "Plate", category = "Effects", inputs = "left,right", outputs = "left,right", first = 136, count = 10,
             doc = "A plate reverb after Dattorro and the Lexicon 224: chorused tank, long decays; Vintage runs it at half rate for the dark Blade Runner / Mercury7 tail."),
    KindSpec(name = "Echo", category = "Effects", inputs = "left,right,time", outputs = "left,right", first = 146, count = 10,
             doc = "Tape (Space Echo: gliding time, wow, flutter, warming repeats), BBD (darker as it grows longer) or digital echo; Ping-Pong crosses the repeats."),
    KindSpec(name = "Chorus", category = "Effects", inputs = "left,right", outputs = "left,right", first = 156, count = 5,
             doc = "BBD chorus: Juno I, II and I+II, a Dimension-style shimmer, or a three-tap string Ensemble."),
    KindSpec(name = "Compressor", category = "Effects", inputs = "left,right,key", outputs = "left,right", first = 161, count = 9,
             doc = "A soft-knee compressor; Squash is OTO BOUM's one knob (past the middle the ratio turns negative), Grit saturates as it squeezes."),
    KindSpec(name = "Tremolo", category = "Effects", inputs = "left,right", outputs = "left,right", first = 170, count = 4,
             doc = "The Rhodes Suitcase vibrato: a stereo autopan (or mono tremolo) through a light-dependent resistor's lag."),
    KindSpec(name = "Diode Ladder", category = "Filters", inputs = "in,cutoff,resonance", outputs = "out", first = 174, count = 6,
             doc = "A diode ladder (TB-303 or EMS VCS3): unevenly spread poles and a high pass in the feedback, the acid squelch."),
    KindSpec(name = "Lo-Fi", category = "Effects", inputs = "in,rate", outputs = "out", first = 180, count = 7,
             doc = "OTO BISCUIT / BIM style degradation: diode-clipped input, a dropped sample rate with jitter, fewer bits, a resonant low pass."),
    KindSpec(name = "Phaser", category = "Effects", inputs = "left,right", outputs = "left,right", first = 187, count = 8,
             doc = "A stereo phaser: allpass stages swept between Low and High with feedback; Barberpole sweeps endlessly one way."),
    KindSpec(name = "Flanger", category = "Effects", inputs = "left,right", outputs = "left,right", first = 195, count = 7,
             doc = "A flanger: a short swept delay fed back positive or negative; Through-Zero makes the tape-flange null."),
    KindSpec(name = "Tape", category = "Effects", inputs = "left,right", outputs = "left,right", first = 202, count = 8,
             doc = "A tape machine: a saturating head, wow and flutter, the low head bump, the top rolling off, hiss. Studio, Cassette or VHS."),
    KindSpec(name = "Pump", category = "Effects", inputs = "left,right,key", outputs = "left,right", first = 210, count = 8,
             doc = "The French-touch pump: ducks on every beat (or other step) of the song and swells back, as if keyed by the kick; wire key to follow a signal instead."),
    KindSpec(name = "Hall", category = "Effects", inputs = "left,right", outputs = "left,right", first = 218, count = 11,
             doc = "A big hall: diffusion into an eight-line feedback network with swung delays. Gate cuts the tail that long after the input stops (the 80s gated snare)."),
    KindSpec(name = "Supersaw", category = "Sources", inputs = "pitch,fm,detune", outputs = "left,right", first = 229, count = 8,
             doc = "The JP-8000 supersaw: seven detuned saws (Szabo's measured detune and mix curves) spread across the stereo field."),
    KindSpec(name = "Tempo LFO", category = "Modulation", inputs = "", outputs = "out", first = 237, count = 5,
             doc = "An LFO locked to the song's beat: one cycle every 1/32 note to 4 bars; sine, triangle, ramps, square, sample-and-hold, smooth random."),
    KindSpec(name = "Width", category = "Effects", inputs = "left,right", outputs = "left,right", first = 242, count = 4,
             doc = "Stereo width: mid/side (0 mono, 2 twice as wide), lows kept centred below Mono Bass, a Haas delay to widen a mono part."),
    KindSpec(name = "Drum Machine", category = "Drums", inputs = "gate,velocity,pitch", outputs = "out", first = 246, count = 7,
             doc = "An early-80s sample drum machine (LinnDrum, DMX, DrumTraks): each drum played from 8-bit μ-law words at its own clock, so tuning moves pitch and length together."),
    KindSpec(name = "Freq Shifter", category = "Effects", inputs = "left,right,shift", outputs = "left,right", first = 253, count = 4,
             doc = "A frequency shifter: every partial moves by Shift Hz (a few Hz swirls, tens of Hz turn metallic); Spread shifts the right side the other way."),
    KindSpec(name = "EQ", category = "Effects", inputs = "left,right", outputs = "left,right", first = 257, count = 14,
             doc = "A channel EQ for making room in a mix: low and high cut (12 or 24 dB/oct), low and high shelves, two bells."),
    KindSpec(name = "FM Operator", category = "Sources", inputs = "pitch,gate,velocity,mod", outputs = "out", first = 271, count = 11,
             doc = "A DX7 operator: a sine at Ratio times the note with its own envelope; mod (another operator) bends its phase. Wire six as an algorithm for a DX7 voice."),
    KindSpec(name = "Bus Comp", category = "Effects", inputs = "left,right,key", outputs = "left,right,reduction", first = 282, count = 13,
             doc = "The mixing and mastering compressor: VCA (SSL bus glue, Auto release), FET (1176 bite), Opto (LA-2A, program-dependent), Vari-Mu (tube, ratio growing as it squeezes). Side HPF keeps the kick from pumping the mix; Mix for parallel."),
    KindSpec(name = "Limiter", category = "Effects", inputs = "left,right", outputs = "left,right,reduction", first = 295, count = 7,
             doc = "A mastering limiter: looks ahead so nothing passes the Ceiling, true peaks guessed between samples, Auto release against pumping, Soft Clip for density."),
    KindSpec(name = "Scale Quantize", category = "Modulation", inputs = "pitch", outputs = "pitch", first = 302, count = 3,
             doc = "Snaps a pitch to the nearest note of a scale, then steps Degrees along it. Scale Track follows the track's scale (the song's key changes); or pick a scale and root of its own."),
]

## How many comma-separated names `list` holds.
pub func count_names(list: str) -> usize:
    if list.length == 0:
        return 0
    var names: usize = 1
    for byte in list.bytes:
        if byte == ',': names += 1
    return names

## The `index`th comma-separated name of `list`, or "".
pub func name_at(list: str, index: usize) -> str:
    var at: usize = 0
    var start: usize = 0
    let bytes = list.bytes
    for i in 0..<bytes.length:
        if bytes[i] == ',':
            if at == index:
                return (str)bytes[start..<i]
            at += 1
            start = i + 1
    if at == index:
        return (str)bytes[start..]
    return ""

pub func input_count(kind: u32) -> usize:
    return count_names(kinds[(usize)kind].inputs)

pub func output_count(kind: u32) -> usize:
    return count_names(kinds[(usize)kind].outputs)

pub func param_count(kind: u32) -> usize:
    return (usize)kinds[(usize)kind].count

pub func param(kind: u32, index: usize) -> ParamSpec:
    return params[(usize)kinds[(usize)kind].first + index]

test "every kind's parameters are within the table and start inside their range":
    for kind in 0..<(usize)count:
        let spec = kinds[kind]
        assert((usize)spec.first + (usize)spec.count <= params.length)
        assert(count_names(spec.inputs) <= most_inputs and count_names(spec.outputs) <= most_outputs)
        assert((usize)spec.count <= most_params)
        for at in 0..<(usize)spec.count:
            let p = params[(usize)spec.first + at]
            assert(p.name.length > 0 and p.minimum <= p.initial and p.initial <= p.maximum)

test "port names are read from their lists":
    assert(count_names("pitch,gate,velocity,pan") == 4 and count_names("") == 0)
    assert(name_at("pitch,gate,velocity", 1) == "gate" and name_at("in", 0) == "in" and name_at("in", 1) == "")

## Whether a node of `kind` keeps sounding after its note ends (a drum, a
## piano's tine, an echo or reverb): its voice then lives until it is silent.
pub func rings(kind: u32) -> bool:
    return kind == kick or kind == snare or kind == metal or kind == clap or kind == tine or kind == plate or kind == echo or kind == chorus or kind == delay or kind == reverb or kind == tape or kind == hall or kind == drum_machine or kind == freq_shifter

## How long (s) a voice holding `kind` must be silent before it may end: an
## echo's longest time, a plate's predelay, a drum's moment.
pub func ring_hold(kind: u32) -> f32:
    if kind == echo or kind == delay: return 2.3
    if kind == plate or kind == reverb or kind == hall: return 0.6
    if kind == tape: return 0.06
    if kind == chorus: return 0.05
    return 0.02

test "every kind has a name of its own":
    for a in 0..<(usize)count:
        for b in a + 1..<(usize)count:
            assert(kinds[a].name != kinds[b].name, "two kinds share a name")
