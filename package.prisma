#prisma 4.0
def package "luce-audio" {
    str owner = "dymokomi"
    str version = "0.1.3"
    str kind = "package"
    str language = "luce-base"
    str description = "Short PCM playback for Luce/Base programs. The first backend is macOS (NSSound). Windows and Linux are not implemented yet; play_pcm8 fails with unsupported there."
    str readme = "README.md"

    def native "inputs" {
        str[] sources = ["native/fmopl.c", "native/imf.c"]
        str[] frameworks = ["AppKit", "Foundation"]
    }

    def export "audio" {
        str module = "luce_audio.audio"
    }
}
