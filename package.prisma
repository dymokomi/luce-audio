#prisma 4.0
def package "luce-audio" {
    str owner = "dymokomi"
    str version = "0.4.2"
    str kind = "package"
    str language = "luce-base"
    str description = "Audio for Luce/Base: a realtime engine (node-patch instruments and effects, analog and FM models, mixing, scales, live MIDI) on CoreAudio with duplex input, plus PCM playback and an OPL2/IMF renderer."
    str readme = "README.md"
    str[] public = ["audio", "device", "engine", "kinds", "analog", "dsp", "scale"]

    def native "inputs" {
        str[] frameworks = ["AppKit", "Foundation"]
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str path = "../luce-std"
    }

    def dependency "luce-midi" {
        str owner = "dymokomi"
        str path = "../luce-midi"
    }

    def native "macos" {
        str[] frameworks = ["AudioToolbox", "CoreAudio"]
    }

}
